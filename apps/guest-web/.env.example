# Public — safe in the browser bundle; guests reach data only through
# security-definer RPCs and RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# SECRET — server-only, used by /api/scan-receipt for receipt OCR.
# Never prefix this with NEXT_PUBLIC_: that would ship your key to every
# visitor's browser. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
