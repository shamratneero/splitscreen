{
  "name": "@splitsave/host-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "node scripts/prepare-ocr.mjs && expo start --web",
    "build:web": "node scripts/prepare-ocr.mjs && expo export --platform web && node scripts/finalize-web.mjs",
    "build:ios:js": "expo export --platform ios",
    "prebuild:ios": "expo prebuild --platform ios --no-install",
    "ios:native": "expo run:ios",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "prepare:ocr": "node scripts/prepare-ocr.mjs"
  },
  "dependencies": {
    "@splitsave/split-engine": "workspace:*",
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.115.0",
    "@tesseract.js-data/ben": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "expo": "~54.0.0",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.14",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "tesseract.js": "^7.0.0",
    "@splitsave/receipt-parser": "workspace:*",
    "@splitsave/types": "workspace:*",
    "@splitsave/payment-matcher": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.9",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": "22.x"
  }
}
