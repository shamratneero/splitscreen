{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "simulator": {
      "distribution": "internal",
      "ios": { "simulator": true },
      "env": { "APP_VARIANT": "preview" }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": { "APP_VARIANT": "production" }
    }
  }
}
